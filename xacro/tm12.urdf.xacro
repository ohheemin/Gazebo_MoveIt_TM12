<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tm12">
  <xacro:arg name="ns" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="color" default="none" />
  <xacro:arg name="trans_hw_iface" default="hardware_interface/PositionJointInterface" />
  
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.gazebo.xacro" />
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.transmission.xacro" />
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.materials.xacro" />
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.tm12.urdf.xacro" />

  <link name="world">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 2.0 0.01"/> 
      </geometry>
      <material name="LightGrey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 2.0 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1000.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0"
               iyy="100.0" iyz="0.0"
               izz="100.0"/>
    </inertial>
  </link>
  
  <gazebo reference="world">
    <static>true</static>
  </gazebo>

  <link name="support_block">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.63"/> 
      </geometry>
      <material name="BlockGrey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.63"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="500.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="16.58" ixy="0.0" ixz="0.0"
               iyy="16.58" iyz="0.0"
               izz="10.42"/>
    </inertial>
  </link>

  <!-- Gazebo properties for support block -->
  <gazebo reference="support_block">
    <static>true</static>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Joint to attach support block to world -->
  <joint name="world_to_support_block" type="fixed">
    <parent link="world"/>
    <child link="support_block"/>
    <origin xyz="0.8 4.6 0.315" rpy="0.0 0.0 3.14159"/>
  </joint>
  
  <joint name="world_to_base_fixed" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)base"/>
    <origin xyz="0.8 4.6 0.63" rpy="0.0 0.0 3.14159"/>
  </joint>

  <xacro:tmr_gazebo ns="$(arg ns)" prefix="$(arg prefix)" />
  <xacro:tmr_transmission prefix="$(arg prefix)" hw_iface="$(arg trans_hw_iface)" />
  <xacro:tmr_materials/>
  
  <xacro:property name="color" value="$(arg color)"/>
  <xacro:if value="${color == 'none'}">
    <xacro:tm12 ns="$(arg ns)" prefix="$(arg prefix)" />
  </xacro:if>

  <xacro:unless value="${color == 'none'}">
    <xacro:tm12 ns="$(arg ns)" prefix="$(arg prefix)" color="${color}" format="stl" />
  </xacro:unless>
  
  
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    
    <joint name="$(arg prefix)joint_1">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="$(arg prefix)joint_2">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="$(arg prefix)joint_3">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="$(arg prefix)joint_4">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="$(arg prefix)joint_5">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="$(arg prefix)joint_6">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  
</robot>
