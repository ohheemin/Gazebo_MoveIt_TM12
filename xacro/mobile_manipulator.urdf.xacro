<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_manipulator">

  <xacro:arg name="ns"                   default="" />
  <xacro:arg name="prefix"               default="" />
  <xacro:arg name="color"                default="none" />
  <xacro:arg name="trans_hw_iface"       default="hardware_interface/PositionJointInterface" />
  <xacro:arg name="ros2_control_hardware_type" default="gazebo" />

  <!-- tm12 매크로 파일들 include -->
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.gazebo.xacro" />
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.transmission.xacro" />
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.materials.xacro" />
  <xacro:include filename="$(find gazebo_test_bed)/xacro/macro.tm12.urdf.xacro" />


  <link name="base_link">
    <inertial>
      <origin xyz="-0.0 -0.000558579656259341 0.19628085445742" rpy="0 0 0" />
      <mass value="31.7708874265635" />
      <inertia ixx="1.4321537364116817"  ixy="-0.00021015290755151665" ixz="0.005496458779909017"
               iyy="2.3703850448798"     iyz="7.091594704601167e-05"
               izz="3.2982263614754664" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gazebo_test_bed/meshes/ld250/meshes/base/base_link_without_box.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.60 0.32 0.15" />
      </geometry>
    </collision>
  </link>

  <!-- Wheel Left -->
  <link name="wheel_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00372" ixy="0" ixz="0"
               iyy="0.00704" iyz="0"
               izz="0.00372"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09684" length="0.04"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.09684" length="0.04" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="0.0 0.1991 0.09684" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_left" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Wheel Right -->
  <link name="wheel_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00372" ixy="0" ixz="0"
               iyy="0.00704" iyz="0"
               izz="0.00372"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.09684" length="0.04"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.09684" length="0.04" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel_right_joint" type="continuous">
    <origin xyz="0.0 -0.1991 0.09684" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_right" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Caster Front Left -->
  <link name="caster_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="2.0e-7" ixy="0" ixz="0"
               iyy="5.42e-7" iyz="0"
               izz="4.09e-7"/>
    </inertial>
  </link>
  <joint name="caster_front_left_joint" type="fixed">
    <origin xyz="0.2182 0.1238 0.011" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_front_left"/>
  </joint>

  <!-- Caster Front Right -->
  <link name="caster_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="2.0e-7" ixy="0" ixz="0"
               iyy="5.42e-7" iyz="0"
               izz="4.09e-7"/>
    </inertial>
  </link>
  <joint name="caster_front_right_joint" type="fixed">
    <origin xyz="0.2182 -0.1238 0.011" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_front_right"/>
  </joint>

  <!-- Caster Back Left -->
  <link name="caster_back_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="2.0e-7" ixy="0" ixz="0"
               iyy="5.42e-7" iyz="0"
               izz="4.09e-7"/>
    </inertial>
  </link>
  <joint name="caster_back_left_joint" type="fixed">
    <origin xyz="-0.2182 0.1725 0.011" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_back_left"/>
  </joint>

  <!-- Caster Back Right -->
  <link name="caster_back_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="2.0e-7" ixy="0" ixz="0"
               iyy="5.42e-7" iyz="0"
               izz="4.09e-7"/>
    </inertial>
  </link>
  <joint name="caster_back_right_joint" type="fixed">
    <origin xyz="-0.2182 -0.1725 0.011" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_back_right"/>
  </joint>

  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
      <material name="black">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
    </collision>
  </link>
  <!-- LD250 Upper Link -->
  <link name="upper_link">
    <inertial>
      <origin xyz="0.0 7.40048026755735E-07 0.183962865049824" rpy="0 0 0" />
      <mass value="37.86583486185633" />
      <inertia ixx="1.8045202567614834"   ixy="-4.3952180272563335e-07" ixz="-0.0039263930777950835"
               iyy="2.9443091970742164"   iyz="4.0945343968703666e-08"
               izz="3.9494696074514165" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gazebo_test_bed/meshes/ld250/meshes/upper/upper_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.850980392156863 0.850980392156863 0.850980392156863 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gazebo_test_bed/meshes/ld250/meshes/upper/upper_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="upper_joint" type="fixed">
    <origin xyz="0 0 0.38281" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="upper_link" />
  </joint>

  <joint name="scan_joint" type="fixed">
    <origin xyz="0.35 0 0.20" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_scan" />
  </joint>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="upper_link" />
    <child link="$(arg prefix)base" />
    <origin xyz="0.0 0.0 0.38281" rpy="0.0 0.0 0.0" />
  </joint>

  <xacro:tmr_transmission prefix="$(arg prefix)" hw_iface="$(arg trans_hw_iface)" />
  <xacro:tmr_materials/>

  <xacro:property name="color" value="$(arg color)"/>
  <xacro:if value="${color == 'none'}">
    <xacro:tm12 ns="$(arg ns)" prefix="$(arg prefix)" />
  </xacro:if>
  <xacro:unless value="${color == 'none'}">
    <xacro:tm12 ns="$(arg ns)" prefix="$(arg prefix)" color="${color}" format="stl" />
  </xacro:unless>

  <!-- DiffDrive -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.3982</wheel_separation>
      <wheel_radius>0.09684</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>2.84</max_angular_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <min_angular_velocity>-2.84</min_angular_velocity>
      <publish_wheel_joint_state>true</publish_wheel_joint_state>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

  <!-- JointStatePublisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/mobile_manipulator/joint_states</topic>
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Lidar 센서 -->
  <gazebo reference="base_scan">
    <sensor name="hls_lfcd_lds" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>mobile_manipulator/scan</topic>
      <ignition_frame_id>base_scan</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="caster_front_left">
    <surface><friction><ode>
      <mu>0.0</mu><mu2>0.0</mu2><slip1>1.0</slip1><slip2>1.0</slip2>
    </ode></friction></surface>
  </gazebo>
  <gazebo reference="caster_front_right">
    <surface><friction><ode>
      <mu>0.0</mu><mu2>0.0</mu2><slip1>1.0</slip1><slip2>1.0</slip2>
    </ode></friction></surface>
  </gazebo>
  <gazebo reference="caster_back_left">
    <surface><friction><ode>
      <mu>0.0</mu><mu2>0.0</mu2><slip1>1.0</slip1><slip2>1.0</slip2>
    </ode></friction></surface>
  </gazebo>
  <gazebo reference="caster_back_right">
    <surface><friction><ode>
      <mu>0.0</mu><mu2>0.0</mu2><slip1>1.0</slip1><slip2>1.0</slip2>
    </ode></friction></surface>
  </gazebo>

  <gazebo reference="wheel_left_joint">
    <provideFeedback>true</provideFeedback>
    <dynamics><damping>0.0</damping><friction>0.0</friction></dynamics>
  </gazebo>
  <gazebo reference="wheel_right_joint">
    <provideFeedback>true</provideFeedback>
    <dynamics><damping>0.0</damping><friction>0.0</friction></dynamics>
  </gazebo>


  <gazebo>
    <plugin filename="ign_ros2_control-system"
            name="ign_ros2_control::IgnitionROS2ControlPlugin">
            
      <ros>
        <namespace>mobile_manipulator</namespace>
      </ros>
            
      <robot_param_node>mobile_robot_state_publisher</robot_param_node>
      <parameters>$(find gazebo_test_bed)/tm_config/mobile_manipulator_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <ros2_control name="mobile_manipulator_GazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="$(arg prefix)joint_1">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg prefix)joint_2">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg prefix)joint_3">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg prefix)joint_4">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg prefix)joint_5">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg prefix)joint_6">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_left_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_right_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

 <gazebo>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
</robot>
