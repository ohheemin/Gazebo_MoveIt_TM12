  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <!-- Small mass and inertia for the sensor frame -->
      <mass value="0.05" />
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <!-- Small cylinder to represent the sensor mount -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
      <material name="black">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
    </collision>
  </link>
  <joint name="scan_joint" type="fixed">
    <!-- Position the sensor above the chassis to avoid mesh overlap -->
    <origin xyz="0.265 0 0.20" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_scan" />
  </joint>

<gazebo reference="caster_front_left">
  <surface>
    <friction>
      <ode>
        <mu>0.0</mu>
        <mu2>0.0</mu2>
        <slip1>1.0</slip1>
        <slip2>1.0</slip2>
      </ode>
    </friction>
  </surface>
</gazebo>

<gazebo reference="caster_front_right">
  <surface>
    <friction>
      <ode>
        <mu>0.0</mu>
        <mu2>0.0</mu2>
        <slip1>1.0</slip1>
        <slip2>1.0</slip2>
      </ode>
    </friction>
  </surface>
</gazebo>

<gazebo reference="caster_back_left">
  <surface>
    <friction>
      <ode>
        <mu>0.0</mu>
        <mu2>0.0</mu2>
        <slip1>1.0</slip1>
        <slip2>1.0</slip2>
      </ode>
    </friction>
  </surface>
</gazebo>

<gazebo reference="caster_back_right">
  <surface>
    <friction>
      <ode>
        <mu>0.0</mu>
        <mu2>0.0</mu2>
        <slip1>1.0</slip1>
        <slip2>1.0</slip2>
      </ode>
    </friction>
  </surface>
</gazebo>

  <!-- Gazebo properties for base_scan link -->
  <gazebo reference="base_scan">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  
  <!-- [플러그인 블록] 각 기능별 Gazebo/ROS2 플러그인 자동 삽입 -->
  
  
  <!-- [DiffDrive] 차동구동 플러그인: cmd_vel/odom/tf 토픽, 조인트/파라미터 설정 -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <!-- 네임스페이스 제거 - 글로벌 토픽 사용 -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.16</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      
      <max_wheel_torque>20</max_wheel_torque>
      
      
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      
      
      <max_linear_velocity>0.22</max_linear_velocity>
      
      
      <max_angular_velocity>2.84</max_angular_velocity>
      
      
      <min_linear_velocity>-0.22</min_linear_velocity>
      
      
      <min_angular_velocity>-2.84</min_angular_velocity>
      
      
      <publish_wheel_joint_state>true</publish_wheel_joint_state>
      
      <publish_odom>true</publish_odom>
      
      <publish_odom_tf>true</publish_odom_tf>
      
    </plugin>
  </gazebo>
  
  
  
  
  <!-- [Lidar] 센서 플러그인: GPU Ray 기반 라이다 센서 설정 -->
  <gazebo reference="base_scan">
    <sensor name="hls_lfcd_lds" type="gpu_ray">
      <pose>-0.032 0 0.171 0 0 0</pose>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>pallet_amr/scan</topic>
      <ignition_frame_id>base_scan</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
  
  
  
  
  <!-- [JointStatePublisher] 조인트 상태 퍼블리셔 플러그인 -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      
      <ros>
        <namespace>pallet_amr</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      
      <topic>joint_states</topic>
      <update_rate>30</update_rate>
      
      <joint_name>wheel_left_joint</joint_name>
      
      <joint_name>wheel_right_joint</joint_name>
      
    </plugin>
  </gazebo>
  
  
  
  
  <!-- [구버전 lidar] 플러그인 블록은 생략됨 (센서 블록으로 대체) -->
  
  
  

  <!-- [Wheel Joint] 바퀴 조인트의 Gazebo 동적 속성(마찰/댐핑) 설정 -->
  <gazebo reference="wheel_left_joint">
    <provideFeedback>true</provideFeedback>
    <dynamics>
      <damping>0.0</damping>
      <friction>0.0</friction>
    </dynamics>
  </gazebo>
  
  <gazebo reference="wheel_right_joint">
    <provideFeedback>true</provideFeedback>
    <dynamics>
      <damping>0.0</damping>
      <friction>0.0</friction>
    </dynamics>
  </gazebo>

  <!-- [Lidar 센서] sensor_frame 아래에 라이다 센서 추가 -->
  
  <gazebo reference="base_scan">

    <sensor name="hls_lfcd_lds_2" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <topic>pallet_amr/scan</topic>
      <ignition_frame_id>base_scan</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
  
  

</robot>
